datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum SocialPlatform {
  X
  DISCORD
  TELEGRAM
  LINKEDIN
  WHATSAPP
  EMAIL
  INSTAGRAM
  FACEBOOK
}

enum QuestFrequency {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
  REPEATABLE
  ACHIEVEMENT
}

enum QuestCategory {
  DAILY
  WEEKLY
  REFERRAL
  SOCIAL
  EARNING
  MILESTONE
  ACHIEVEMENT
  GENERAL
}

enum SpinOutcome {
  GP_20
  GP_50
  GP_100
  XP_20
  FRAGMENT_1
  FREE_SPIN_1
  NOTHING
  RP_XP_20
}

enum LedgerSource {
  CHECKIN
  QUEST
  SPIN
  INVITE
  SOCIAL
  SOCIAL_CLAWBACK
  CONVERSION
  ADMIN_ADJUSTMENT
  RARE_PASS
}

enum LedgerType {
  CREDIT
  DEBIT
}

enum RarePassSeasonStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
  ARCHIVED
}

enum RarePassTrack {
  FREE
  PREMIUM
}

enum RarePassRewardType {
  GP
  XP
  FRAGMENT
  SPIN
  CARD
  AVATAR
}

enum RpXpSource {
  DAILY_CHECKIN
  QUEST
  SPIN
  SOCIAL
  REFERRAL
  COLLECTION
  CARD_CRAFT
}

enum RarePassMissionType {
  DAILY
  WEEKLY
  SEASONAL
}

enum AvatarVariantType {
  BASIC
  THREE_D
}

enum CardRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
  MYTHICAL
}


// ─────────────────────────────────────────────
// Core User & Progression
// ─────────────────────────────────────────────

model User {
  id              String   @id @default(uuid())
  createdBy       String?
  createdDate     DateTime @default(now())
  updatedBy       String?
  updatedDate     DateTime @updatedAt
  isDelete        Boolean  @default(false)
  isActive        Boolean  @default(true)

  walletAddress   String?  @unique
  displayName     String?
  email           String?  @unique
  role            UserRole @default(USER)

  // Progression
  level Int @default(1)
  xp    Int @default(0) // XP within current level (resets on level-up)
  gp    Int @default(0) // spendable Gold Points balance
  jlt   Decimal @default(0) @db.Decimal(18, 6)
  fragments Int @default(0) // collected fragments for rare cards

  walletConnected     Boolean @default(false)
  profileCompleted    Boolean @default(false)

  // Relations
  streak              Streak?
  gpLedger            GpLedgerEntry[]
  xpLedger            XpLedgerEntry[]
  questCompletions    UserQuestCompletion[]
  socialConnections   SocialConnection[]
  spinState           SpinState?
  spinHistory         SpinResult[]
  invitesSent         Invite[]              @relation("Inviter")
  inviteRedemption    InviteRedemption?     @relation("RedeemedByUser")
  cards               UserCard[]

  // Rare Pass & Avatar Relations
  activeAvatarVariantId String?
  activeAvatarVariant   AvatarVariant?        @relation("ActiveAvatar", fields: [activeAvatarVariantId], references: [id])
  userAvatars           UserAvatar[]
  rpXpLedger            RpXpLedgerEntry[]
  rarePassClaims        RarePassRewardClaim[]
  missionCompletions    UserRarePassMissionCompletion[]
  rarePassPurchases     RarePassPurchase[]
  refreshTokens         RefreshToken[]
  auditLogs             AuditLog[]

  @@index([gp])
  @@index([xp])
  @@map("users")
}

// ─────────────────────────────────────────────
// Daily Check-In / Streak
// ─────────────────────────────────────────────

model Streak {
  id               String   @id @default(uuid())
  createdBy        String?
  createdDate      DateTime @default(now())
  updatedBy        String?
  updatedDate      DateTime @updatedAt
  isDelete         Boolean  @default(false)
  isActive         Boolean  @default(true)

  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentDay       Int      @default(0)     // 1-7, resets to 1 after a miss
  longestStreak    Int      @default(0)     // All-time peak streak in days
  lastCheckInDate  DateTime? @db.Date       // UTC calendar date of last successful claim
  lastCheckInAt    DateTime?

  @@map("streaks")
}

// ─────────────────────────────────────────────
// Quests (onboarding + repeatable)
// ─────────────────────────────────────────────

model Quest {
  id              String   @id @default(uuid())
  createdBy       String?
  createdDate     DateTime @default(now())
  updatedBy       String?
  updatedDate     DateTime @updatedAt
  isDelete        Boolean  @default(false)
  isActive        Boolean  @default(true)

  code            String   @unique // e.g. "quest_connect_wallet"
  name            String
  description     String?
  gpReward        Int
  xpReward        Int
  rpXpReward      Int @default(0)
  fragmentReward  Int @default(0)
  frequency       QuestFrequency
  category        QuestCategory @default(GENERAL)
  isHidden        Boolean       @default(false)

  completions     UserQuestCompletion[]

  @@map("quests")
}

model UserQuestCompletion {
  id              String   @id @default(uuid())
  createdBy       String?
  createdDate     DateTime @default(now())
  updatedBy       String?
  updatedDate     DateTime @updatedAt
  isDelete        Boolean  @default(false)
  isActive        Boolean  @default(true)

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId         String
  quest           Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)

  completedAt     DateTime @default(now())
  periodKey       String   // e.g. "2026-08-07" (daily) / "2026-W32" (weekly) / "ALL" (one_time/repeatable instance id)
  gpAwarded       Int
  xpAwarded       Int

  // Prevents double-claiming the same quest within the same period
  @@unique([userId, questId, periodKey])
  @@index([userId, questId])
  @@index([userId, createdDate])
  @@map("user_quest_completions")
}

// ─────────────────────────────────────────────
// Spin to Win
// ─────────────────────────────────────────────

model SpinState {
  id                       String   @id @default(uuid())
  createdBy                String?
  createdDate              DateTime @default(now())
  updatedBy                String?
  updatedDate              DateTime @updatedAt
  isDelete                 Boolean  @default(false)
  isActive                 Boolean  @default(true)

  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  freeSpinUsedDate         DateTime? @db.Date // Legacy field
  purchasedSpinsAvailable  Int       @default(0) // Legacy field
  
  availableFreeSpins       Int       @default(1)
  lastFreeSpinAt           DateTime?
  totalSpins               Int       @default(0)

  @@map("spin_states")
}

model SpinResult {
  id              String   @id @default(uuid())
  createdBy       String?
  createdDate     DateTime @default(now())
  updatedBy       String?
  updatedDate     DateTime @updatedAt
  isDelete        Boolean  @default(false)
  isActive        Boolean  @default(true)

  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  outcome         SpinOutcome
  gpAwarded       Int
  usedFree        Boolean

  @@index([userId, createdDate])
  @@map("spin_results")
}

// ─────────────────────────────────────────────
// Invites / Squad
// ─────────────────────────────────────────────

model Invite {
  id              String   @id @default(uuid())
  createdBy       String?
  createdDate     DateTime @default(now())
  updatedBy       String?
  updatedDate     DateTime @updatedAt
  isDelete        Boolean  @default(false)
  isActive        Boolean  @default(true)

  code            String   @unique
  inviterId       String
  inviter         User     @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)

  redemptions     InviteRedemption[]

  @@index([inviterId])
  @@map("invites")
}

model InviteRedemption {
  id               String   @id @default(uuid())
  createdBy        String?
  createdDate      DateTime @default(now())
  updatedBy        String?
  updatedDate      DateTime @updatedAt
  isDelete         Boolean  @default(false)
  isActive         Boolean  @default(true)

  inviteId         String
  invite           Invite   @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  // The NEW user who redeemed the code — one redemption per user, ever
  redeemedByUserId String @unique
  redeemedByUser   User   @relation("RedeemedByUser", fields: [redeemedByUserId], references: [id], onDelete: Cascade)

  inviterGpAwarded Int
  inviterXpAwarded Int
  redeemedAt       DateTime @default(now())

  @@map("invite_redemptions")
}

// ─────────────────────────────────────────────
// Social Connections (X / Discord / Telegram)
// ─────────────────────────────────────────────

model SocialConnection {
  id                   String   @id @default(uuid())
  createdBy            String?
  createdDate          DateTime @default(now())
  updatedBy            String?
  updatedDate          DateTime @updatedAt
  isDelete             Boolean  @default(false)
  isActive             Boolean  @default(true)

  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform             SocialPlatform
  platformUserId       String         // provider's account id — unique per platform, enforces 1 wallet per account
  handle               String?
  email                String?
  accessToken          String?
  refreshToken         String?
  tokenExpiresAt       DateTime?
  metadata             String?        // JSON string for extra details like profile pic, deep link payload, etc.

  connected            Boolean        @default(true)
  connectionBonusPaid  Boolean        @default(false)
  linkedAt             DateTime       @default(now())
  unlinkedAt           DateTime?
  clawbackApplied      Boolean        @default(false)

  socialQuestClaims    SocialQuestClaim[]

  @@unique([platform, platformUserId]) // prevents multi-accounting across wallets
  @@unique([userId, platform])         // one connection per platform per user
  @@index([userId])
  @@map("social_connections")
}

model SocialQuest {
  id              String   @id @default(uuid())
  createdBy       String?
  createdDate     DateTime @default(now())
  updatedBy       String?
  updatedDate     DateTime @updatedAt
  isDelete        Boolean  @default(false)
  isActive        Boolean  @default(true)

  code            String   @unique // e.g. "x_follow", "telegram_tapin"
  platform        SocialPlatform
  name            String
  description     String?
  gpReward        Int
  xpReward        Int
  rpXpReward      Int @default(0)
  frequency       QuestFrequency
  category        QuestCategory @default(SOCIAL)
  isHidden        Boolean       @default(false)

  claims          SocialQuestClaim[]

  @@map("social_quests")
}

model SocialQuestClaim {
  id                   String   @id @default(uuid())
  createdBy            String?
  createdDate          DateTime @default(now())
  updatedBy            String?
  updatedDate          DateTime @updatedAt
  isDelete             Boolean  @default(false)
  isActive             Boolean  @default(true)

  socialConnectionId   String
  socialConnection     SocialConnection @relation(fields: [socialConnectionId], references: [id], onDelete: Cascade)
  socialQuestId        String
  socialQuest          SocialQuest      @relation(fields: [socialQuestId], references: [id], onDelete: Cascade)

  periodKey            String           // "2026-08-07" daily / "2026-W32" weekly / "ALL" one_time
  gpAwarded            Int
  xpAwarded            Int
  claimedAt            DateTime         @default(now())

  @@unique([socialConnectionId, socialQuestId, periodKey])
  @@map("social_quest_claims")
}

// ─────────────────────────────────────────────
// Ledgers (audit trail for GP / XP movement)
// ─────────────────────────────────────────────

model GpLedgerEntry {
  id          String   @id @default(uuid())
  createdBy   String?
  createdDate DateTime @default(now())
  updatedBy   String?
  updatedDate DateTime @updatedAt
  isDelete    Boolean  @default(false)
  isActive    Boolean  @default(true)

  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        LedgerType
  amount      Int          // positive for credit, negative for debit
  source      LedgerSource
  refId       String?      // e.g. questId, platform, spinResultId, inviteId

  @@index([userId, createdDate])
  @@index([userId, source])
  @@map("gp_ledger_entries")
}

model XpLedgerEntry {
  id          String   @id @default(uuid())
  createdBy   String?
  createdDate DateTime @default(now())
  updatedBy   String?
  updatedDate DateTime @updatedAt
  isDelete    Boolean  @default(false)
  isActive    Boolean  @default(true)

  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount      Int
  source      LedgerSource
  refId       String?

  @@index([userId, createdDate])
  @@map("xp_ledger_entries")
}

// ─────────────────────────────────────────────
// Server-side tunables (avoids hardcoding rates/curves in client)
// ─────────────────────────────────────────────

model SystemConfig {
  id          String   @id @default(uuid())
  createdBy   String?
  createdDate DateTime @default(now())
  updatedBy   String?
  updatedDate DateTime @updatedAt
  isDelete    Boolean  @default(false)
  isActive    Boolean  @default(true)

  key         String   @unique // e.g. "gp_to_jlt_rate", "xp_level_base", "xp_level_growth"
  value       String   // store as string, parse per key (e.g. "100", "500", "1.3")

  @@map("system_config")
}

// ─────────────────────────────────────────────
// Collections & Fragments
// ─────────────────────────────────────────────

model RareCard {
  id        String     @id @default(uuid())
  name      String
  imageUrl  String
  rarity    CardRarity @default(COMMON)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  userCards UserCard[]

  @@map("rare_cards")
}

model UserCard {
  id        String   @id @default(uuid())
  userId    String
  cardId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  card      RareCard @relation(fields: [cardId], references: [id])

  @@unique([userId, cardId])
  @@index([userId])
  @@map("user_cards")
}

// ─────────────────────────────────────────────
// Rare Pass Seasonal progression
// ─────────────────────────────────────────────

model RarePassSeason {
  id            String            @id @default(uuid())
  name          String
  startAt       DateTime
  endAt         DateTime
  status        RarePassSeasonStatus
  maxLevel      Int
  levels        RarePassLevel[]
  missions      RarePassMission[]
  ledgerEntries RpXpLedgerEntry[]
  purchases     RarePassPurchase[]

  @@map("rare_pass_seasons")
}

model RarePassLevel {
  id           String           @id @default(uuid())
  seasonId     String
  level        Int
  requiredRpXp Int
  rewards      RarePassReward[]
  season       RarePassSeason   @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, level])
  @@map("rare_pass_levels")
}

model RarePassReward {
  id          String             @id @default(uuid())
  levelId     String
  track       RarePassTrack
  rewardType  RarePassRewardType
  amount      Int?
  metadata    Json?
  sortOrder   Int                @default(0)
  level       RarePassLevel      @relation(fields: [levelId], references: [id], onDelete: Cascade)
  claims      RarePassRewardClaim[]

  @@map("rare_pass_rewards")
}

model RarePassRewardClaim {
  id          String         @id @default(uuid())
  userId      String
  seasonId    String
  rewardId    String
  claimedAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward      RarePassReward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([userId, rewardId])
  @@map("rare_pass_reward_claims")
}

model RpXpLedgerEntry {
  id             String         @id @default(uuid())
  userId         String
  seasonId       String
  amount         Int
  source         RpXpSource
  sourceId       String?
  idempotencyKey String?
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  season         RarePassSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@map("rp_xp_ledger_entries")
}

model RarePassPurchase {
  id          String         @id @default(uuid())
  userId      String
  seasonId    String
  purchasedAt DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  season      RarePassSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId])
  @@map("rare_pass_purchases")
}

// ─────────────────────────────────────────────
// Rare Pass Missions
// ─────────────────────────────────────────────

model RarePassMission {
  id           String         @id @default(uuid())
  seasonId     String
  code         String
  name         String
  description  String?
  rpXpReward   Int
  type         RarePassMissionType
  targetCount  Int            @default(1)
  season       RarePassSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  completions  UserRarePassMissionCompletion[]

  @@map("rare_pass_missions")
}

model UserRarePassMissionCompletion {
  id           String         @id @default(uuid())
  userId       String
  missionId    String
  completedAt  DateTime       @default(now())
  periodKey    String
  progress     Int            @default(0)
  completed    Boolean        @default(false)
  rpXpAwarded  Int            @default(0)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission      RarePassMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId, periodKey])
  @@map("user_rare_pass_mission_completions")
}

// ─────────────────────────────────────────────
// Avatars & User Identity
// ─────────────────────────────────────────────

model Avatar {
  id           String          @id @default(uuid())
  name         String
  characterKey String          @unique
  variants     AvatarVariant[]

  @@map("avatars")
}

model AvatarVariant {
  id                String          @id @default(uuid())
  avatarId          String
  type              AvatarVariantType
  imageUrl          String?
  modelUrl          String?
  unlockDescription String?
  isPurchasable     Boolean         @default(false)
  costGp            Int             @default(0)
  costJlt           Decimal         @default(0) @db.Decimal(18, 6)
  avatar            Avatar          @relation(fields: [avatarId], references: [id], onDelete: Cascade)
  userAvatars       UserAvatar[]
  usersActive       User[]          @relation("ActiveAvatar")

  @@map("avatar_variants")
}

model UserAvatar {
  id         String        @id @default(uuid())
  userId     String
  variantId  String
  unlockedAt DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant    AvatarVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@map("user_avatars")
}

// ─────────────────────────────────────────────
// Security & Authentication Hardening Models
// ─────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
  FINANCIAL_OPERATOR
  SYSTEM
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   // e.g. "AUTH_LOGIN_SUCCESS", "AUTH_LOGIN_FAILED", "USER_LOGOUT", "SPIN_PURCHASE", "REWARD_CLAIM", "ROLE_CHANGE"
  ipAddress   String?
  userAgent   String?
  metadata    Json?    // Detailed context/state changes
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}
